# Copy to .env and fill in with your own app from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
# Optional and unused by the browser app. Never prefix this with VITE_.
SPOTIFY_CLIENT_SECRET=

# Optional: ElevenLabs voice for the guidance. Create your own key at
# https://elevenlabs.io/app/developers/api-keys then run `npm run voice`.
# Never prefix this with VITE_.
ELEVENLABS_API_KEY=
# Optional: a voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
